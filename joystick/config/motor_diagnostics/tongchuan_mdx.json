    { "index": "0x1001", "format": "u32_hex" },
    { "index": "0x200F", "format": "u32_hex" },
    { "index": "0x6077", "format": "i16_0p1pct", "unit_note": "rated Tq" },
    { "index": "0x6078", "format": "i16_0p1pct", "unit_note": "rated I" },
    { "index": "0x6061", "format": "i8_dec", "unit_note": "mode display (1=PP,3=PV,9=CSV)" }
  ]
